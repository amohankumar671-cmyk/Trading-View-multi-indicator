//@version=6
indicator("Volume Profile Checker", shorttitle = "VP Check", overlay = true, max_boxes_count = 500, max_labels_count = 100, max_lines_count = 100)

// Session volume profile (POC / VAH / VAL) plus confluence checks against
// daily VWAP and CPR from cpr_vwap_camarilla_suite.pine.

type VpResult
    float poc
    float vah
    float val
    int pocI
    int loI
    int hiI
    float tot
    float maxV

// =============================================================================
// Helpers (CPR / VWAP style aligned with the suite)
// =============================================================================
f_prevDay() =>
    request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_on)

f_cpr(float h, float l, float c) =>
    float piv = (h + l + c) / 3.0
    float bc  = (h + l) / 2.0
    float tc  = piv - bc + piv
    [math.max(tc, bc), piv, math.min(tc, bc)]

f_cam(float h, float l, float c) =>
    float rng = h - l
    float r3 = c + rng * 1.1 / 4.0
    float s3 = c - rng * 1.1 / 4.0
    [r3, s3]

f_fillProfile(array<float> highs, array<float> lows, array<float> vols, array<float> prof, int nBins, float sL, float sH) =>
    array.fill(prof, 0.0)
    float rng = sH - sL
    int n = array.size(highs)
    if rng > 0 and n > 0
        float binSz = rng / nBins
        for i = 0 to n - 1
            float bh = array.get(highs, i)
            float bl = array.get(lows, i)
            float bv = array.get(vols, i)
            int i0 = int((bl - sL) / binSz)
            int i1 = int((bh - sL) / binSz)
            i0 := math.max(0, math.min(nBins - 1, i0))
            i1 := math.max(0, math.min(nBins - 1, i1))
            if bh >= sH
                i1 := nBins - 1
            int span = math.max(1, i1 - i0 + 1)
            float share = bv / span
            for b = i0 to i1
                array.set(prof, b, array.get(prof, b) + share)
    rng > 0 ? rng / nBins : 0.0

f_pocVa(array<float> prof, int nBins, float sL, float binSz, float vaPct) =>
    int pocI = 0
    float maxV = array.get(prof, 0)
    float tot = 0.0
    for b = 0 to nBins - 1
        float v = array.get(prof, b)
        tot += v
        if v > maxV
            maxV := v
            pocI := b
    float target = tot * vaPct / 100.0
    float acc = array.get(prof, pocI)
    int loI = pocI
    int hiI = pocI
    int guard = 0
    while acc < target and guard < nBins
        guard += 1
        float below = loI > 0 ? array.get(prof, loI - 1) : -1.0
        float above = hiI < nBins - 1 ? array.get(prof, hiI + 1) : -1.0
        if above >= below and hiI < nBins - 1
            hiI += 1
            acc += array.get(prof, hiI)
        else if loI > 0
            loI -= 1
            acc += array.get(prof, loI)
        else if hiI < nBins - 1
            hiI += 1
            acc += array.get(prof, hiI)
        else
            break
    float pocPx = sL + (pocI + 0.5) * binSz
    float valPx = sL + loI * binSz
    float vahPx = sL + (hiI + 1) * binSz
    VpResult.new(pocPx, vahPx, valPx, pocI, loI, hiI, tot, maxV)

f_dashCell(table t, int r, string k, string v, color vc) =>
    table.cell(t, 0, r, k, text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(t, 1, r, v, text_color = vc, text_halign = text.align_right, text_size = size.small)

colBlue = #2962FF
colGrn  = #089981
colRed  = #F23645
colOrg  = #ff9800
colPoc  = #e91e63
colVah  = #26a69a
colVal  = #ab47bc

// =============================================================================
// Inputs
// =============================================================================
gVp = "------- VOLUME PROFILE -------"
showVp       = input.bool(true, "Show volume profile", group = gVp)
vpBins       = input.int(24, "Rows", minval = 8, maxval = 48, group = gVp)
vpVaPct      = input.float(70.0, "Value area %", minval = 50.0, maxval = 95.0, step = 1.0, group = gVp)
vpWidth      = input.int(18, "Histogram width (bars)", minval = 4, maxval = 80, group = gVp)
showHist     = input.bool(true, "Show histogram", group = gVp)
showPoc      = input.bool(true, "Show POC", inline = "poc", group = gVp)
showVahVal   = input.bool(true, "Show VAH / VAL", inline = "poc", group = gVp)
showPrevVp   = input.bool(true, "Show previous session POC / VAH / VAL", group = gVp)
showVaFill   = input.bool(true, "Shade value area", group = gVp)
vaInCol      = input.color(color.new(#089981, 92), "Inside VA", inline = "va", group = gVp)
histVaCol    = input.color(color.new(#26a69a, 55), "VA bin", inline = "hist", group = gVp)
histOutCol   = input.color(color.new(#787b86, 70), "Outside bin", inline = "hist", group = gVp)
histPocCol   = input.color(color.new(#e91e63, 35), "POC bin", inline = "hist", group = gVp)

gChk = "------- VOLUME CHECKS -------"
nearPct      = input.float(0.12, "Near POC / level %", minval = 0.01, maxval = 1.0, step = 0.01, tooltip = "Price or VWAP/CPR is 'near' a VP level when the distance is within this percent of price.", group = gChk)
bgVpStatus   = input.bool(true, "Background: inside / outside value area", group = gChk)
showTable    = input.bool(true, "Show status table", group = gChk)
showMarks    = input.bool(true, "Mark POC tests and VA breaks", group = gChk)

gVwap = "------- VWAP (confluence) -------"
showVWAP     = input.bool(true, "Show VWAP", group = gVwap)
vwapSrc      = input.source(hlc3, "VWAP src", group = gVwap)
vwapCol      = input.color(#ffeb3b, "VWAP color", group = gVwap)

gCpr = "------- CPR (confluence) -------"
showDCpr = input.bool(true, "Show Daily CPR", group = gCpr)
showPDH  = input.bool(false, "Show Prev Day High", group = gCpr)
showPDL  = input.bool(false, "Show Prev Day Low", group = gCpr)
showCam  = input.bool(false, "Show Camarilla S3 / R3", group = gCpr)

// =============================================================================
// Daily CPR / Camarilla
// =============================================================================
[dH, dL, dC] = f_prevDay()
[dTC, dPiv, dBC] = f_cpr(dH, dL, dC)
[cR3, cS3] = f_cam(dH, dL, dC)

kgs = plot.style_circles
plot(showDCpr ? dTC  : na, "Daily TC",    color = colBlue, style = kgs, linewidth = 2)
plot(showDCpr ? dPiv : na, "Daily Pivot", color = colBlue, style = kgs, linewidth = 2)
plot(showDCpr ? dBC  : na, "Daily BC",    color = colBlue, style = kgs, linewidth = 2)
plot(showPDH ? dH : na, "Prev Day High", color = #000000, style = kgs, linewidth = 2)
plot(showPDL ? dL : na, "Prev Day Low",  color = #000000, style = kgs, linewidth = 2)
plot(showCam ? cR3 : na, "Cam R3", color = colGrn, linewidth = 2)
plot(showCam ? cS3 : na, "Cam S3", color = colRed, linewidth = 2)

// =============================================================================
// Daily VWAP
// =============================================================================
var float sumPV = 0.0
var float sumV  = 0.0
float vol = nz(volume)
bool newDay = ta.change(time("D")) != 0
if newDay
    sumPV := vwapSrc * vol
    sumV  := vol
else
    sumPV += vwapSrc * vol
    sumV  += vol
float vwapVal = sumV == 0 ? vwapSrc : sumPV / sumV
plot(showVWAP ? vwapVal : na, "VWAP", color = vwapCol, linewidth = 2)

// =============================================================================
// Session volume profile
// =============================================================================
var array<float> sessH = array.new_float()
var array<float> sessL = array.new_float()
var array<float> sessV = array.new_float()
var array<float> prof  = array.new_float()
var float prevPoc = na
var float prevVah = na
var float prevVal = na

if barstate.isfirst
    array.clear(prof)
    for i = 0 to vpBins - 1
        array.push(prof, 0.0)

if newDay and array.size(sessH) > 0
    float pH = array.max(sessH)
    float pL = array.min(sessL)
    float pBin = f_fillProfile(sessH, sessL, sessV, prof, vpBins, pL, pH)
    if pBin > 0
        VpResult prevR = f_pocVa(prof, vpBins, pL, pBin, vpVaPct)
        prevPoc := prevR.poc
        prevVah := prevR.vah
        prevVal := prevR.val
    array.clear(sessH)
    array.clear(sessL)
    array.clear(sessV)

array.push(sessH, high)
array.push(sessL, low)
array.push(sessV, vol)

float sH = array.max(sessH)
float sL = array.min(sessL)
float binSz = f_fillProfile(sessH, sessL, sessV, prof, vpBins, sL, sH)
float poc = na
float vah = na
float val = na
int pocI = 0
int loI = 0
int hiI = 0
float totV = 0.0
float maxV = 0.0
if binSz > 0
    VpResult r = f_pocVa(prof, vpBins, sL, binSz, vpVaPct)
    poc := r.poc
    vah := r.vah
    val := r.val
    pocI := r.pocI
    loI := r.loI
    hiI := r.hiI
    totV := r.tot
    maxV := r.maxV

plot(showVp and showPoc ? poc : na, "POC", color = colPoc, linewidth = 2)
plot(showVp and showVahVal ? vah : na, "VAH", color = colVah, linewidth = 2)
plot(showVp and showVahVal ? val : na, "VAL", color = colVal, linewidth = 2)
pVah = plot(showVp and showVaFill ? vah : na, "VAH fill", color = color.new(colVah, 100), display = display.none)
pVal = plot(showVp and showVaFill ? val : na, "VAL fill", color = color.new(colVal, 100), display = display.none)
fill(pVah, pVal, color = showVp and showVaFill ? color.new(#26a69a, 90) : na, title = "Value area")

plot(showPrevVp ? prevPoc : na, "Prev POC", color = color.new(colPoc, 30), style = kgs, linewidth = 2)
plot(showPrevVp ? prevVah : na, "Prev VAH", color = color.new(colVah, 30), style = kgs, linewidth = 2)
plot(showPrevVp ? prevVal : na, "Prev VAL", color = color.new(colVal, 30), style = kgs, linewidth = 2)

// Histogram (redraw on last bar)
var array<box> vpBoxes = array.new<box>()
if barstate.islast
    while array.size(vpBoxes) > 0
        box.delete(array.pop(vpBoxes))
    if showVp and showHist and binSz > 0 and maxV > 0
        for b = 0 to vpBins - 1
            float v = array.get(prof, b)
            int w = math.max(1, int(math.round(v / maxV * vpWidth)))
            float y1 = sL + b * binSz
            float y2 = y1 + binSz
            color bc = b == pocI ? histPocCol : (b >= loI and b <= hiI ? histVaCol : histOutCol)
            box bx = box.new(bar_index - w, y2, bar_index + 1, y1, xloc = xloc.bar_index, border_color = color.new(bc, 20), bgcolor = bc, text = b == pocI ? "POC" : "")
            array.push(vpBoxes, bx)

// =============================================================================
// Volume-profile checks
// =============================================================================
float nearAbs = nz(close) * nearPct / 100.0
bool haveVp   = not na(poc) and not na(vah) and not na(val)
bool inVA     = haveVp and close <= vah and close >= val
bool aboveVAH = haveVp and close > vah
bool nearPoc  = haveVp and math.abs(close - poc) <= nearAbs
bool testPoc  = nearPoc and (low <= poc and high >= poc)
bool breakVAH = haveVp and ta.crossover(close, vah)
bool breakVAL = haveVp and ta.crossunder(close, val)
bool rejectVAH = haveVp and high >= vah and close < vah and close[1] <= vah
bool rejectVAL = haveVp and low <= val and close > val and close[1] >= val

bool vwapNearPoc = showVWAP and haveVp and math.abs(vwapVal - poc) <= nearAbs
bool cprInVA     = showDCpr and haveVp and dPiv >= val and dPiv <= vah
bool cprNearPoc  = showDCpr and haveVp and math.abs(dPiv - poc) <= nearAbs
bool vwapInVA    = showVWAP and haveVp and vwapVal >= val and vwapVal <= vah
bool camR3NearVah = showCam and haveVp and math.abs(cR3 - vah) <= nearAbs
bool camS3NearVal = showCam and haveVp and math.abs(cS3 - val) <= nearAbs

string locTxt = not haveVp ? "n/a" : inVA ? "Inside value" : aboveVAH ? "Above VAH" : "Below VAL"
color locCol  = not haveVp ? color.gray : inVA ? colGrn : aboveVAH ? colOrg : colRed

bgcolor(bgVpStatus and haveVp ? (inVA ? color.new(colGrn, 94) : color.new(colRed, 94)) : na, title = "VA status")

plotshape(showMarks and testPoc ? poc : na, title = "POC test", style = shape.diamond, location = location.absolute, size = size.tiny, color = colPoc, text = "POC")
plotshape(showMarks and breakVAH, title = "VAH break", style = shape.triangleup, location = location.belowbar, size = size.tiny, color = colGrn, text = "VAH")
plotshape(showMarks and breakVAL, title = "VAL break", style = shape.triangledown, location = location.abovebar, size = size.tiny, color = colRed, text = "VAL")

var table dash = table.new(position.top_right, 2, 12, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.new(color.gray, 40))

if barstate.islast and showTable
    table.cell(dash, 0, 0, "VP Check", text_color = color.black, text_halign = text.align_left, text_size = size.normal)
    table.cell(dash, 1, 0, totV == 0 ? "no volume" : str.tostring(vpVaPct, "#") + "% VA", text_color = color.black, text_halign = text.align_right, text_size = size.small)
    f_dashCell(dash, 1, "Location", locTxt, locCol)
    f_dashCell(dash, 2, "POC", haveVp ? str.tostring(poc, format.mintick) : "n/a", colPoc)
    f_dashCell(dash, 3, "VAH", haveVp ? str.tostring(vah, format.mintick) : "n/a", colVah)
    f_dashCell(dash, 4, "VAL", haveVp ? str.tostring(val, format.mintick) : "n/a", colVal)
    f_dashCell(dash, 5, "Near POC", nearPoc ? "YES" : "no", nearPoc ? colPoc : color.gray)
    f_dashCell(dash, 6, "VWAP vs VA", vwapInVA ? "inside" : (showVWAP ? "outside" : "off"), vwapInVA ? colGrn : color.gray)
    f_dashCell(dash, 7, "VWAP ~ POC", vwapNearPoc ? "aligned" : "no", vwapNearPoc ? colGrn : color.gray)
    f_dashCell(dash, 8, "CPR in VA", cprInVA ? "YES" : (showDCpr ? "no" : "off"), cprInVA ? colGrn : color.gray)
    f_dashCell(dash, 9, "CPR ~ POC", cprNearPoc ? "aligned" : "no", cprNearPoc ? colBlue : color.gray)
    f_dashCell(dash, 10, "R3 ~ VAH", camR3NearVah ? "aligned" : (showCam ? "no" : "off"), camR3NearVah ? colGrn : color.gray)
    f_dashCell(dash, 11, "S3 ~ VAL", camS3NearVal ? "aligned" : (showCam ? "no" : "off"), camS3NearVal ? colRed : color.gray)
else if barstate.islast and not showTable
    table.clear(dash, 0, 0, 1, 11)

alertcondition(testPoc, "POC test", "Price traded through session POC")
alertcondition(breakVAH, "Break above VAH", "Price closed above Value Area High")
alertcondition(breakVAL, "Break below VAL", "Price closed below Value Area Low")
alertcondition(rejectVAH, "VAH rejection", "Wick above VAH, close back inside value")
alertcondition(rejectVAL, "VAL rejection", "Wick below VAL, close back inside value")
alertcondition(vwapNearPoc, "VWAP aligned with POC", "Session VWAP is near volume-profile POC")
alertcondition(cprInVA, "CPR inside value area", "Daily CPR pivot is inside the session value area")
