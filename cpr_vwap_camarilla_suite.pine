//@version=6
indicator("CPR Indicator", shorttitle = "CPR", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

type VpResult
    float poc
    float vah
    float val
    int pocI
    int loI
    int hiI
    float tot
    float maxV

// =============================================================================
// Helpers
// =============================================================================
f_ma(float src, simple int len, string kind) =>
    float ema  = ta.ema(src, len)
    float wma  = ta.wma(src, len)
    float hma  = ta.hma(src, len)
    float vwma = ta.vwma(src, len)
    float rma  = ta.rma(src, len)
    float sma  = ta.sma(src, len)
    switch kind
        "EMA"  => ema
        "WMA"  => wma
        "HMA"  => hma
        "VWMA" => vwma
        "RMA"  => rma
        => sma

f_mtf(float src, simple int len, string kind, simple string tf) =>
    tf == "" or tf == timeframe.period ? f_ma(src, len, kind) : request.security(syminfo.tickerid, tf, f_ma(src, len, kind), barmerge.gaps_off, barmerge.lookahead_off)

f_prevDay() =>
    request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_on)

f_cpr(float h, float l, float c) =>
    float piv = (h + l + c) / 3.0
    float bc  = (h + l) / 2.0
    float tc  = piv - bc + piv
    [math.max(tc, bc), piv, math.min(tc, bc)]

f_rs(float h, float l, float c) =>
    float pp = (h + l + c) / 3.0
    float rng = h - l
    [2.0 * pp - l, pp + rng, h + 2.0 * (pp - l), pp + 3.0 * rng, 2.0 * pp - h, pp - rng, l - 2.0 * (h - pp), pp - 3.0 * rng]

f_cam(float h, float l, float c) =>
    float rng = h - l
    float r4 = c + rng * 1.1 / 2.0
    float r3 = c + rng * 1.1 / 4.0
    float r2 = c + rng * 1.1 / 6.0
    float r1 = c + rng * 1.1 / 12.0
    float pp = (h + l + c) / 3.0
    float s1 = c - rng * 1.1 / 12.0
    float s2 = c - rng * 1.1 / 6.0
    float s3 = c - rng * 1.1 / 4.0
    float s4 = c - rng * 1.1 / 2.0
    float r5 = l != 0 ? (h / l) * c : na
    float s5 = not na(r5) ? c - (r5 - c) : na
    [pp, r1, r2, r3, r4, r5, s1, s2, s3, s4, s5]

f_camTxt(string name, bool showPx, float p) =>
    name + (showPx ? " " + str.tostring(p, format.mintick) : "")

f_camLabStyle(bool labLeft) =>
    labLeft ? label.style_label_right : label.style_label_left

// One Camarilla segment per trading day: session open → session close (no extend.right).
f_camLevel(bool on, float px, color col, int w, string name, bool showLab, bool showPx, bool labLeft, int lookback, bool newDay, int t0, int t1) =>
    var line ln = na
    var label curLab = na
    var line[] hist = array.new<line>()
    var label[] labs = array.new<label>()
    int x2 = na(t1) ? time : t1
    if not on or na(px)
        if not na(ln)
            line.delete(ln)
            ln := na
        if not na(curLab)
            label.delete(curLab)
            curLab := na
        while array.size(hist) > 0
            line.delete(array.pop(hist))
        while array.size(labs) > 0
            label.delete(array.pop(labs))
    else
        if newDay and not na(ln)
            int prevEnd = na(t1[1]) ? time[1] : t1[1]
            line.set_xy1(ln, line.get_x1(ln), px[1])
            line.set_xy2(ln, prevEnd, px[1])
            line.set_extend(ln, extend.none)
            array.push(hist, ln)
            if showLab
                array.push(labs, label.new(line.get_x1(ln), px[1], f_camTxt(name, showPx, px[1]), xloc = xloc.bar_time, style = f_camLabStyle(labLeft), color = color.new(color.white, 100), textcolor = col, size = size.small))
            while array.size(hist) > lookback
                line.delete(array.shift(hist))
            while array.size(labs) > lookback
                label.delete(array.shift(labs))
            ln := line.new(t0, px, x2, px, xloc = xloc.bar_time, extend = extend.none, color = col, width = w)
        else if na(ln)
            ln := line.new(t0, px, x2, px, xloc = xloc.bar_time, extend = extend.none, color = col, width = w)
        else
            line.set_xy1(ln, t0, px)
            line.set_xy2(ln, x2, px)
            line.set_extend(ln, extend.none)
            line.set_color(ln, col)
            line.set_width(ln, w)
        if showLab
            int lx = labLeft ? t0 : x2
            if na(curLab)
                curLab := label.new(lx, px, f_camTxt(name, showPx, px), xloc = xloc.bar_time, style = f_camLabStyle(labLeft), color = color.new(color.white, 100), textcolor = col, size = size.small)
            else
                label.set_xy(curLab, lx, px)
                label.set_text(curLab, f_camTxt(name, showPx, px))
                label.set_textcolor(curLab, col)
        else if not na(curLab)
            label.delete(curLab)
            curLab := na
    ln

f_fillProfile(array<float> highs, array<float> lows, array<float> vols, array<float> prof, int nBins, float sL, float sH) =>
    array.fill(prof, 0.0)
    float rng = sH - sL
    int n = array.size(highs)
    if rng > 0 and n > 0
        float binSz = rng / nBins
        for i = 0 to n - 1
            float bh = array.get(highs, i)
            float bl = array.get(lows, i)
            float bv = array.get(vols, i)
            int i0 = int((bl - sL) / binSz)
            int i1 = int((bh - sL) / binSz)
            i0 := math.max(0, math.min(nBins - 1, i0))
            i1 := math.max(0, math.min(nBins - 1, i1))
            if bh >= sH
                i1 := nBins - 1
            int span = math.max(1, i1 - i0 + 1)
            float share = bv / span
            for b = i0 to i1
                array.set(prof, b, array.get(prof, b) + share)
    rng > 0 ? rng / nBins : 0.0

f_pocVa(array<float> prof, int nBins, float sL, float binSz, float vaPct) =>
    int pocI = 0
    float maxV = array.get(prof, 0)
    float tot = 0.0
    for b = 0 to nBins - 1
        float v = array.get(prof, b)
        tot += v
        if v > maxV
            maxV := v
            pocI := b
    float target = tot * vaPct / 100.0
    float acc = array.get(prof, pocI)
    int loI = pocI
    int hiI = pocI
    int guard = 0
    while acc < target and guard < nBins
        guard += 1
        float below = loI > 0 ? array.get(prof, loI - 1) : -1.0
        float above = hiI < nBins - 1 ? array.get(prof, hiI + 1) : -1.0
        if above >= below and hiI < nBins - 1
            hiI += 1
            acc += array.get(prof, hiI)
        else if loI > 0
            loI -= 1
            acc += array.get(prof, loI)
        else if hiI < nBins - 1
            hiI += 1
            acc += array.get(prof, hiI)
        else
            break
    float pocPx = sL + (pocI + 0.5) * binSz
    float valPx = sL + loI * binSz
    float vahPx = sL + (hiI + 1) * binSz
    VpResult.new(pocPx, vahPx, valPx, pocI, loI, hiI, tot, maxV)

f_dashCell(table t, int r, string k, string v, color vc) =>
    table.cell(t, 0, r, k, text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(t, 1, r, v, text_color = vc, text_halign = text.align_right, text_size = size.small)

colBlue = #2962FF
colBlk  = #000000
colGrn  = #089981
colRed  = #F23645
colOrg  = #ff9800
colPoc  = #e91e63
colVah  = #26a69a
colVal  = #ab47bc

// =============================================================================
// ------- CPR (Daily only) -------
// =============================================================================
gCpr = "------- CPR -------"
cprMode  = input.string("Manual", "Select Pivot Mode", options = ["Manual"], group = gCpr)
showDCpr = input.bool(true, "Show Daily CPR (Manual)", group = gCpr)
showPDH  = input.bool(true, "Show Prev Day High", group = gCpr)
showPDL  = input.bool(true, "Show Prev Day Low", group = gCpr)
showDRS  = input.bool(true, "Show Daily R1-R4 / S1-S4", group = gCpr)

// =============================================================================
// ------- CAMARILLA -------
// =============================================================================
gCam = "------- CAMARILLA -------"
showCam     = input.bool(true, "Show Camarilla", group = gCam)
camBack     = input.int(15, "Number of pivots back", minval = 1, maxval = 50, group = gCam)
camDaily    = input.bool(true, "Use daily-based values", group = gCam)
camLabels   = input.bool(true, "Show labels", inline = "camLab", group = gCam)
camPrices   = input.bool(true, "Show prices", inline = "camLab", group = gCam)
camLabPos   = input.string("Left", "Labels position", options = ["Left", "Right"], group = gCam)
camW        = input.int(3, "Line width", minval = 1, maxval = 5, group = gCam)

camPOn  = input.bool(false, "P",  inline = "p",  group = gCam)
camPCol = input.color(colOrg, "P color", inline = "p", group = gCam)
camS1On = input.bool(false, "S1", inline = "s1", group = gCam)
camS1Col = input.color(colOrg, "S1 color", inline = "s1", group = gCam)
camR1On = input.bool(false, "R1", inline = "r1", group = gCam)
camR1Col = input.color(colOrg, "R1 color", inline = "r1", group = gCam)
camS2On = input.bool(false, "S2", inline = "s2", group = gCam)
camS2Col = input.color(colOrg, "S2 color", inline = "s2", group = gCam)
camR2On = input.bool(false, "R2", inline = "r2", group = gCam)
camR2Col = input.color(colOrg, "R2 color", inline = "r2", group = gCam)
camS3On = input.bool(true,  "S3", inline = "s3", group = gCam)
camS3Col = input.color(colBlk, "S3 color", inline = "s3", group = gCam)
camR3On = input.bool(true,  "R3", inline = "r3", group = gCam)
camR3Col = input.color(colBlk, "R3 color", inline = "r3", group = gCam)
camS4On = input.bool(false, "S4", inline = "s4", group = gCam)
camS4Col = input.color(colOrg, "S4 color", inline = "s4", group = gCam)
camR4On = input.bool(false, "R4", inline = "r4", group = gCam)
camR4Col = input.color(colOrg, "R4 color", inline = "r4", group = gCam)
camS5On = input.bool(false, "S5", inline = "s5", group = gCam)
camS5Col = input.color(colOrg, "S5 color", inline = "s5", group = gCam)
camR5On = input.bool(false, "R5", inline = "r5", group = gCam)
camR5Col = input.color(colOrg, "R5 color", inline = "r5", group = gCam)

// =============================================================================
// ------- VWAP -------
// =============================================================================
gVwap = "------- VWAP -------"
showVWAP     = input.bool(true,  "Show VWAP", inline = "vwap", group = gVwap)
showVwapBand = input.bool(false, "Show Bands", inline = "vwap", group = gVwap)
vwapSrc      = input.source(hlc3, "VWAP src", inline = "vwap", group = gVwap)
vwapSd1      = input.float(1.0, "SD1", minval = 0.1, step = 0.1, inline = "vwapB", group = gVwap)
vwapSd2      = input.float(2.0, "SD2", minval = 0.1, step = 0.1, inline = "vwapB", group = gVwap)
vwapCol      = input.color(#ffeb3b, "VWAP color", inline = "vwapB", group = gVwap)

// =============================================================================
// ------- MOVING AVERAGES -------
// =============================================================================
gMa = "------- MOVING AVERAGES -------"
ma1On  = input.bool(true,  "MA #1", inline = "ma1", group = gMa)
ma1Typ = input.string("SMA", "MA1 type", options = ["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], inline = "ma1", group = gMa)
ma1Src = input.source(close, "MA1 src", inline = "ma1", group = gMa)
ma1Len = input.int(10, "MA1 len", minval = 1, inline = "ma1", group = gMa)
ma1Tf  = input.timeframe("", "MA1 TF", inline = "ma1", group = gMa)
ma1Col = input.color(#1b5e20, "MA1 color", inline = "ma1", group = gMa)

ma2On  = input.bool(true,  "MA #2", inline = "ma2", group = gMa)
ma2Typ = input.string("SMA", "MA2 type", options = ["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], inline = "ma2", group = gMa)
ma2Src = input.source(close, "MA2 src", inline = "ma2", group = gMa)
ma2Len = input.int(20, "MA2 len", minval = 1, inline = "ma2", group = gMa)
ma2Tf  = input.timeframe("", "MA2 TF", inline = "ma2", group = gMa)
ma2Col = input.color(#ffeb3b, "MA2 color", inline = "ma2", group = gMa)

ma3On  = input.bool(false, "MA #3", inline = "ma3", group = gMa)
ma3Typ = input.string("SMA", "MA3 type", options = ["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], inline = "ma3", group = gMa)
ma3Src = input.source(close, "MA3 src", inline = "ma3", group = gMa)
ma3Len = input.int(50, "MA3 len", minval = 1, inline = "ma3", group = gMa)
ma3Tf  = input.timeframe("", "MA3 TF", inline = "ma3", group = gMa)
ma3Col = input.color(#00bcd4, "MA3 color", inline = "ma3", group = gMa)

ma4On  = input.bool(false, "MA #4", inline = "ma4", group = gMa)
ma4Typ = input.string("SMA", "MA4 type", options = ["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], inline = "ma4", group = gMa)
ma4Src = input.source(close, "MA4 src", inline = "ma4", group = gMa)
ma4Len = input.int(100, "MA4 len", minval = 1, inline = "ma4", group = gMa)
ma4Tf  = input.timeframe("D", "MA4 TF", inline = "ma4", group = gMa)
ma4Col = input.color(#9c27b0, "MA4 color", inline = "ma4", group = gMa)

ma5On  = input.bool(false, "MA #5", inline = "ma5", group = gMa)
ma5Typ = input.string("SMA", "MA5 type", options = ["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], inline = "ma5", group = gMa)
ma5Src = input.source(close, "MA5 src", inline = "ma5", group = gMa)
ma5Len = input.int(200, "MA5 len", minval = 1, inline = "ma5", group = gMa)
ma5Tf  = input.timeframe("D", "MA5 TF", inline = "ma5", group = gMa)
ma5Col = input.color(#ffffff, "MA5 color", inline = "ma5", group = gMa)

// =============================================================================
// ------- ALPHATREND (KivancOzbilgic, MPL 2.0) -------
// =============================================================================
gAt = "------- ALPHATREND -------"
showAT        = input.bool(true, "Show AlphaTrend", group = gAt)
atCoeff       = input.float(1, "Multiplier", step = 0.1, group = gAt)
atAP          = input.int(14, "Common Period", minval = 1, group = gAt)
atSrc         = input.source(close, "Source", group = gAt)
atShowSignals = input.bool(true, "Show Signals?", group = gAt)
atNoVolume    = input.bool(false, "Change calculation (no volume data)?", group = gAt)

// =============================================================================
// ------- VOLUME PROFILE -------
// =============================================================================
gVp = "------- VOLUME PROFILE -------"
showVp     = input.bool(true, "Show volume profile", group = gVp)
vpBins     = input.int(24, "Rows", minval = 8, maxval = 48, group = gVp)
vpVaPct    = input.float(70.0, "Value area %", minval = 50.0, maxval = 95.0, step = 1.0, group = gVp)
vpWidth    = input.int(18, "Histogram width (bars)", minval = 4, maxval = 80, group = gVp)
showHist   = input.bool(true, "Show histogram", group = gVp)
showPoc    = input.bool(true, "Show POC", inline = "poc", group = gVp)
showVahVal = input.bool(true, "Show VAH / VAL", inline = "poc", group = gVp)
showPrevVp = input.bool(true, "Show previous session POC / VAH / VAL", group = gVp)
showVaFill = input.bool(true, "Shade value area", group = gVp)
histVaCol  = input.color(color.new(#26a69a, 55), "VA bin", inline = "hist", group = gVp)
histOutCol = input.color(color.new(#787b86, 70), "Outside bin", inline = "hist", group = gVp)
histPocCol = input.color(color.new(#e91e63, 35), "POC bin", inline = "hist", group = gVp)

gChk = "------- VOLUME CHECKS -------"
nearPct    = input.float(0.12, "Near POC %", minval = 0.01, maxval = 1.0, step = 0.01, tooltip = "Price is near POC when the distance is within this percent of price.", group = gChk)
bgVpStatus = input.bool(true, "Background: inside / outside value area", group = gChk)
showTable  = input.bool(true, "Show status table", group = gChk)
showMarks  = input.bool(true, "Mark POC tests and VA breaks", group = gChk)

gSig = "------- VP BUY / SELL -------"
vpShowSignals = input.bool(true, "Show BUY / SELL on strong breaks", group = gSig)
sigPrev       = input.bool(true, "Break previous session VAH / VAL", tooltip = "More stable. Buy = close breaks above yesterday's VAH. Sell = close breaks below yesterday's VAL.", group = gSig)
sigCurr       = input.bool(false, "Break current session VAH / VAL", tooltip = "Noisier because today's VAH/VAL still move. Off by default.", group = gSig)
atrLen        = input.int(14, "ATR length", minval = 1, group = gSig)
atrMult       = input.float(0.5, "Min bar change vs ATR", minval = 0.1, step = 0.1, tooltip = "High-change filter: |close - close[1]| must be at least this times ATR so tiny pokes do not fire.", group = gSig)
volLen        = input.int(20, "Volume average length", minval = 1, group = gSig)
volMult       = input.float(1.2, "Min volume vs average", minval = 0.0, step = 0.1, tooltip = "Break bar volume must be at least this times SMA(volume). Set 0 to ignore volume.", group = gSig)
needBody      = input.bool(true, "Require bullish / bearish close vs open", group = gSig)
fromInside    = input.bool(true, "Current-session break must leave value", tooltip = "For current VAH/VAL signals, the previous close must be inside the value area.", group = gSig)

// =============================================================================
// Daily levels
// =============================================================================
[dH, dL, dC] = f_prevDay()
[dTC, dPiv, dBC] = f_cpr(dH, dL, dC)
[dR1, dR2, dR3, dR4, dS1, dS2, dS3, dS4] = f_rs(dH, dL, dC)
[cPP, cR1, cR2, cR3, cR4, cR5, cS1, cS2, cS3, cS4, cS5] = f_cam(dH, dL, dC)

// KGS layout: dotted circles, stepped by day, colored price-scale titles
kgs = plot.style_circles
plot(showDCpr ? dTC  : na, "Daily TC",        color = colBlue, style = kgs, linewidth = 2)
plot(showDCpr ? dPiv : na, "Daily Pivot",     color = colBlue, style = kgs, linewidth = 2)
plot(showDCpr ? dBC  : na, "Daily BC",        color = colBlue, style = kgs, linewidth = 2)
plot(showDRS ? dR1 : na, "Daily R1", color = colGrn, style = kgs, linewidth = 2)
plot(showDRS ? dR2 : na, "Daily R2", color = colGrn, style = kgs, linewidth = 2)
plot(showDRS ? dR3 : na, "Daily R3", color = colGrn, style = kgs, linewidth = 2)
plot(showDRS ? dR4 : na, "Daily R4", color = colGrn, style = kgs, linewidth = 2)
plot(showDRS ? dS1 : na, "Daily S1", color = colRed, style = kgs, linewidth = 2)
plot(showDRS ? dS2 : na, "Daily S2", color = colRed, style = kgs, linewidth = 2)
plot(showDRS ? dS3 : na, "Daily S3", color = colRed, style = kgs, linewidth = 2)
plot(showDRS ? dS4 : na, "Daily S4", color = colRed, style = kgs, linewidth = 2)
plot(showPDH ? dH : na, "Prev Day High", color = colBlk, style = kgs, linewidth = 2)
plot(showPDL ? dL : na, "Prev Day Low",  color = colBlk, style = kgs, linewidth = 2)

bool camOn = showCam
bool labLeft = camLabPos == "Left"
bool newDay = ta.change(time("D")) != 0
int t0 = time("D")
int t1 = time_close("D")
f_camLevel(camOn and camPOn,  cPP, camPCol,  camW, "P",  camLabels, camPrices, labLeft, camBack, newDay, t0, t1)
f_camLevel(camOn and camR1On, cR1, camR1Col, camW, "R1", camLabels, camPrices, labLeft, camBack, newDay, t0, t1)
f_camLevel(camOn and camR2On, cR2, camR2Col, camW, "R2", camLabels, camPrices, labLeft, camBack, newDay, t0, t1)
f_camLevel(camOn and camR3On, cR3, camR3Col, camW, "R3", camLabels, camPrices, labLeft, camBack, newDay, t0, t1)
f_camLevel(camOn and camR4On, cR4, camR4Col, camW, "R4", camLabels, camPrices, labLeft, camBack, newDay, t0, t1)
f_camLevel(camOn and camR5On, cR5, camR5Col, camW, "R5", camLabels, camPrices, labLeft, camBack, newDay, t0, t1)
f_camLevel(camOn and camS1On, cS1, camS1Col, camW, "S1", camLabels, camPrices, labLeft, camBack, newDay, t0, t1)
f_camLevel(camOn and camS2On, cS2, camS2Col, camW, "S2", camLabels, camPrices, labLeft, camBack, newDay, t0, t1)
f_camLevel(camOn and camS3On, cS3, camS3Col, camW, "S3", camLabels, camPrices, labLeft, camBack, newDay, t0, t1)
f_camLevel(camOn and camS4On, cS4, camS4Col, camW, "S4", camLabels, camPrices, labLeft, camBack, newDay, t0, t1)
f_camLevel(camOn and camS5On, cS5, camS5Col, camW, "S5", camLabels, camPrices, labLeft, camBack, newDay, t0, t1)

// =============================================================================
// VWAP / MA
// =============================================================================
var float sumPV  = 0.0
var float sumV   = 0.0
var float sumP2V = 0.0
float vol = nz(volume)
if ta.change(time("D")) != 0
    sumPV  := vwapSrc * vol
    sumV   := vol
    sumP2V := vwapSrc * vwapSrc * vol
else
    sumPV  += vwapSrc * vol
    sumV   += vol
    sumP2V += vwapSrc * vwapSrc * vol

float vwapVal = sumV == 0 ? vwapSrc : sumPV / sumV
float vwapSd  = sumV == 0 ? 0.0 : math.sqrt(math.max(sumP2V / sumV - vwapVal * vwapVal, 0.0))

pVwap = plot(showVWAP ? vwapVal : na, "VWAP", color = vwapCol, linewidth = 2)
pVu1  = plot(showVWAP and showVwapBand ? vwapVal + vwapSd * vwapSd1 : na, "VWAP +1 SD", color = color.new(vwapCol, 40))
pVl1  = plot(showVWAP and showVwapBand ? vwapVal - vwapSd * vwapSd1 : na, "VWAP -1 SD", color = color.new(vwapCol, 40))
plot(showVWAP and showVwapBand ? vwapVal + vwapSd * vwapSd2 : na, "VWAP +2 SD", color = color.new(vwapCol, 65))
plot(showVWAP and showVwapBand ? vwapVal - vwapSd * vwapSd2 : na, "VWAP -2 SD", color = color.new(vwapCol, 65))
fill(pVu1, pVl1, color = showVWAP and showVwapBand ? color.new(vwapCol, 88) : na, title = "VWAP band fill")

plot(ma1On ? f_mtf(ma1Src, ma1Len, ma1Typ, ma1Tf) : na, "MA #1", color = ma1Col, linewidth = 2)
plot(ma2On ? f_mtf(ma2Src, ma2Len, ma2Typ, ma2Tf) : na, "MA #2", color = ma2Col, linewidth = 2)
plot(ma3On ? f_mtf(ma3Src, ma3Len, ma3Typ, ma3Tf) : na, "MA #3", color = ma3Col, linewidth = 2)
plot(ma4On ? f_mtf(ma4Src, ma4Len, ma4Typ, ma4Tf) : na, "MA #4", color = ma4Col, linewidth = 2)
plot(ma5On ? f_mtf(ma5Src, ma5Len, ma5Typ, ma5Tf) : na, "MA #5", color = ma5Col, linewidth = 2)

// AlphaTrend — author/developer © KivancOzbilgic, Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
float atAtr = ta.sma(ta.tr, atAP)
float upT = low - atAtr * atCoeff
float downT = high + atAtr * atCoeff
float AlphaTrend = 0.0
AlphaTrend := (atNoVolume ? ta.rsi(atSrc, atAP) >= 50 : ta.mfi(hlc3, atAP) >= 50) ? upT < nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : upT : downT > nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : downT

color atFill = AlphaTrend > AlphaTrend[2] ? #00E60F : AlphaTrend < AlphaTrend[2] ? #80000B : AlphaTrend[1] > AlphaTrend[3] ? #00E60F : #80000B
atK1 = plot(showAT ? AlphaTrend : na, "AlphaTrend", color = color.new(#0022FC, 0), linewidth = 3)
atK2 = plot(showAT ? AlphaTrend[2] : na, "AlphaTrend[2]", color = color.new(#FC0400, 0), linewidth = 3)
fill(atK1, atK2, color = showAT ? atFill : na, title = "AlphaTrend fill")

bool buySignalk = ta.crossover(AlphaTrend, AlphaTrend[2])
bool sellSignalk = ta.crossunder(AlphaTrend, AlphaTrend[2])
int K1 = ta.barssince(buySignalk)
int K2 = ta.barssince(sellSignalk)
int O1 = ta.barssince(buySignalk[1])
int O2 = ta.barssince(sellSignalk[1])

plotshape(showAT and buySignalk and atShowSignals and O1 > K2 ? AlphaTrend[2] * 0.9999 : na, title = "AT BUY", text = "BUY", location = location.absolute, style = shape.labelup, size = size.tiny, color = color.new(#0022FC, 0), textcolor = color.new(color.white, 0))
plotshape(showAT and sellSignalk and atShowSignals and O2 > K1 ? AlphaTrend[2] * 1.0001 : na, title = "AT SELL", text = "SELL", location = location.absolute, style = shape.labeldown, size = size.tiny, color = color.new(color.maroon, 0), textcolor = color.new(color.white, 0))

// =============================================================================
// Volume profile
// =============================================================================
var array<float> sessH = array.new_float()
var array<float> sessL = array.new_float()
var array<float> sessV = array.new_float()
var array<float> prof  = array.new_float()
var float prevPoc = na
var float prevVah = na
var float prevVal = na

if barstate.isfirst
    array.clear(prof)
    for i = 0 to vpBins - 1
        array.push(prof, 0.0)

if newDay and array.size(sessH) > 0
    float pH = array.max(sessH)
    float pL = array.min(sessL)
    float pBin = f_fillProfile(sessH, sessL, sessV, prof, vpBins, pL, pH)
    if pBin > 0
        VpResult prevR = f_pocVa(prof, vpBins, pL, pBin, vpVaPct)
        prevPoc := prevR.poc
        prevVah := prevR.vah
        prevVal := prevR.val
    array.clear(sessH)
    array.clear(sessL)
    array.clear(sessV)

array.push(sessH, high)
array.push(sessL, low)
array.push(sessV, vol)

float sH = array.max(sessH)
float sL = array.min(sessL)
float binSz = f_fillProfile(sessH, sessL, sessV, prof, vpBins, sL, sH)
float poc = na
float vah = na
float val = na
int pocI = 0
int loI = 0
int hiI = 0
float totV = 0.0
float maxBinV = 0.0
if binSz > 0
    VpResult r = f_pocVa(prof, vpBins, sL, binSz, vpVaPct)
    poc := r.poc
    vah := r.vah
    val := r.val
    pocI := r.pocI
    loI := r.loI
    hiI := r.hiI
    totV := r.tot
    maxBinV := r.maxV

plot(showVp and showPoc ? poc : na, "POC", color = colPoc, linewidth = 2)
plot(showVp and showVahVal ? vah : na, "VAH", color = colVah, linewidth = 2)
plot(showVp and showVahVal ? val : na, "VAL", color = colVal, linewidth = 2)
pVah = plot(showVp and showVaFill ? vah : na, "VAH fill", color = color.new(colVah, 100), display = display.none)
pVal = plot(showVp and showVaFill ? val : na, "VAL fill", color = color.new(colVal, 100), display = display.none)
fill(pVah, pVal, color = showVp and showVaFill ? color.new(#26a69a, 90) : na, title = "Value area")
plot(showVp and showPrevVp ? prevPoc : na, "Prev POC", color = color.new(colPoc, 30), style = kgs, linewidth = 2)
plot(showVp and showPrevVp ? prevVah : na, "Prev VAH", color = color.new(colVah, 30), style = kgs, linewidth = 2)
plot(showVp and showPrevVp ? prevVal : na, "Prev VAL", color = color.new(colVal, 30), style = kgs, linewidth = 2)

var array<box> vpBoxes = array.new<box>()
if barstate.islast
    while array.size(vpBoxes) > 0
        box.delete(array.pop(vpBoxes))
    if showVp and showHist and binSz > 0 and maxBinV > 0
        for b = 0 to vpBins - 1
            float vRow = array.get(prof, b)
            int w = math.max(1, int(math.round(vRow / maxBinV * vpWidth)))
            float y1 = sL + b * binSz
            float y2 = y1 + binSz
            color bc = b == pocI ? histPocCol : (b >= loI and b <= hiI ? histVaCol : histOutCol)
            box bx = box.new(bar_index - w, y2, bar_index + 1, y1, xloc = xloc.bar_index, border_color = color.new(bc, 20), bgcolor = bc, text = b == pocI ? "POC" : "")
            array.push(vpBoxes, bx)

float nearAbs = nz(close) * nearPct / 100.0
bool haveVp   = not na(poc) and not na(vah) and not na(val)
bool inVA     = haveVp and close <= vah and close >= val
bool aboveVAH = haveVp and close > vah
bool nearPoc  = haveVp and math.abs(close - poc) <= nearAbs
bool testPoc  = nearPoc and (low <= poc and high >= poc)
bool breakVAH = haveVp and ta.crossover(close, vah)
bool breakVAL = haveVp and ta.crossunder(close, val)
bool rejectVAH = haveVp and high >= vah and close < vah and close[1] <= vah
bool rejectVAL = haveVp and low <= val and close > val and close[1] >= val

float atrNow = ta.atr(atrLen)
float barChg = math.abs(close - close[1])
bool highChg = not na(atrNow) and atrNow > 0 and barChg >= atrNow * atrMult
float volAvg = ta.sma(volume, volLen)
bool highVol = volMult <= 0 or (volAvg > 0 and volume >= volAvg * volMult)
bool bullBar = not needBody or close > open
bool bearBar = not needBody or close < open
bool leftValue = not fromInside or inVA[1]
bool havePrevVa = not na(prevVah) and not na(prevVal)

bool buyPrev  = sigPrev and havePrevVa and ta.crossover(close, prevVah) and highChg and highVol and bullBar
bool sellPrev = sigPrev and havePrevVa and ta.crossunder(close, prevVal) and highChg and highVol and bearBar
bool buyCurr  = sigCurr and breakVAH and highChg and highVol and bullBar and leftValue
bool sellCurr = sigCurr and breakVAL and highChg and highVol and bearBar and leftValue
bool vpBuy    = showVp and vpShowSignals and (buyPrev or buyCurr) and not (sellPrev or sellCurr)
bool vpSell   = showVp and vpShowSignals and (sellPrev or sellCurr) and not (buyPrev or buyCurr)

string locTxt = not haveVp ? "n/a" : inVA ? "Inside value" : aboveVAH ? "Above VAH" : "Below VAL"
color locCol  = not haveVp ? color.gray : inVA ? colGrn : aboveVAH ? colOrg : colRed

bgcolor(showVp and bgVpStatus and haveVp ? (inVA ? color.new(colGrn, 94) : color.new(colRed, 94)) : na, title = "VA status")

plotshape(showVp and showMarks and testPoc ? poc : na, title = "POC test", style = shape.diamond, location = location.absolute, size = size.tiny, color = colPoc, text = "POC")
plotshape(showVp and showMarks and breakVAH, title = "VAH break", style = shape.triangleup, location = location.belowbar, size = size.tiny, color = colGrn, text = "VAH")
plotshape(showVp and showMarks and breakVAL, title = "VAL break", style = shape.triangledown, location = location.abovebar, size = size.tiny, color = colRed, text = "VAL")
plotshape(vpBuy, title = "VP BUY", text = "VP BUY", style = shape.labelup, location = location.belowbar, size = size.small, color = color.new(#0022FC, 0), textcolor = color.white)
plotshape(vpSell, title = "VP SELL", text = "VP SELL", style = shape.labeldown, location = location.abovebar, size = size.small, color = color.new(color.maroon, 0), textcolor = color.white)

var table dash = table.new(position.top_right, 2, 10, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.new(color.gray, 40))
if barstate.islast and showVp and showTable
    table.cell(dash, 0, 0, "Volume Profile", text_color = color.black, text_halign = text.align_left, text_size = size.normal)
    table.cell(dash, 1, 0, totV == 0 ? "no volume" : str.tostring(vpVaPct, "#") + "% VA", text_color = color.black, text_halign = text.align_right, text_size = size.small)
    f_dashCell(dash, 1, "Location", locTxt, locCol)
    f_dashCell(dash, 2, "POC", haveVp ? str.tostring(poc, format.mintick) : "n/a", colPoc)
    f_dashCell(dash, 3, "VAH", haveVp ? str.tostring(vah, format.mintick) : "n/a", colVah)
    f_dashCell(dash, 4, "VAL", haveVp ? str.tostring(val, format.mintick) : "n/a", colVal)
    f_dashCell(dash, 5, "Near POC", nearPoc ? "YES" : "no", nearPoc ? colPoc : color.gray)
    f_dashCell(dash, 6, "High change", highChg ? "YES" : "no", highChg ? colGrn : color.gray)
    f_dashCell(dash, 7, "High volume", highVol ? "YES" : "no", highVol ? colGrn : color.gray)
    f_dashCell(dash, 8, "VP BUY", vpBuy ? "YES" : "no", vpBuy ? colGrn : color.gray)
    f_dashCell(dash, 9, "VP SELL", vpSell ? "YES" : "no", vpSell ? colRed : color.gray)
else if barstate.islast and (not showVp or not showTable)
    table.clear(dash, 0, 0, 1, 9)

alertcondition(showVWAP and ta.crossover(close, vwapVal), "Cross above VWAP", "Price crossed above VWAP")
alertcondition(showVWAP and ta.crossunder(close, vwapVal), "Cross below VWAP", "Price crossed below VWAP")
alertcondition(showDCpr and ta.crossover(close, dTC), "Break above Daily CPR", "Price broke above Daily TC")
alertcondition(showDCpr and ta.crossunder(close, dBC), "Break below Daily CPR", "Price broke below Daily BC")
alertcondition(camOn and camR3On and ta.crossover(close, cR3), "Camarilla R3 break", "Price broke Camarilla R3")
alertcondition(camOn and camS3On and ta.crossunder(close, cS3), "Camarilla S3 break", "Price broke Camarilla S3")

alertcondition(showAT and buySignalk and O1 > K2, title = "Potential BUY Alarm", message = "BUY SIGNAL!")
alertcondition(showAT and sellSignalk and O2 > K1, title = "Potential SELL Alarm", message = "SELL SIGNAL!")
alertcondition(showAT and buySignalk[1] and O1[1] > K2, title = "Confirmed BUY Alarm", message = "BUY SIGNAL APPROVED!")
alertcondition(showAT and sellSignalk[1] and O2[1] > K1, title = "Confirmed SELL Alarm", message = "SELL SIGNAL APPROVED!")
alertcondition(showAT and ta.cross(close, AlphaTrend), title = "Price Cross Alert", message = "Price - AlphaTrend Crossing!")
alertcondition(showAT and ta.crossover(low, AlphaTrend), title = "Candle CrossOver Alarm", message = "LAST BAR is ABOVE ALPHATREND")
alertcondition(showAT and ta.crossunder(high, AlphaTrend), title = "Candle CrossUnder Alarm", message = "LAST BAR is BELOW ALPHATREND!")
alertcondition(showAT and ta.cross(close[1], AlphaTrend[1]), title = "Price Cross Alert After Bar Close", message = "Price - AlphaTrend Crossing!")
alertcondition(showAT and ta.crossover(low[1], AlphaTrend[1]), title = "Candle CrossOver Alarm After Bar Close", message = "LAST BAR is ABOVE ALPHATREND!")
alertcondition(showAT and ta.crossunder(high[1], AlphaTrend[1]), title = "Candle CrossUnder Alarm After Bar Close", message = "LAST BAR is BELOW ALPHATREND!")
alertcondition(showVp and testPoc, "POC test", "Price traded through session POC")
alertcondition(showVp and breakVAH, "Break above VAH", "Price closed above Value Area High")
alertcondition(showVp and breakVAL, "Break below VAL", "Price closed below Value Area Low")
alertcondition(showVp and rejectVAH, "VAH rejection", "Wick above VAH, close back inside value")
alertcondition(showVp and rejectVAL, "VAL rejection", "Wick below VAL, close back inside value")
alertcondition(vpBuy, "VP BUY strong VAH break", "Strong high-change break above value area high")
alertcondition(vpSell, "VP SELL strong VAL break", "Strong high-change break below value area low")
