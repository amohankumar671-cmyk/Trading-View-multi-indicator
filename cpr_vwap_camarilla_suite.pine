//@version=6
indicator("CPR VWAP Camarilla MA RSI Supertrend", overlay = true, max_labels_count = 50)

// =============================================================================
// Helpers
// =============================================================================
f_ma(float src, simple int len, string kind) =>
    switch kind
        "EMA"  => ta.ema(src, len)
        "WMA"  => ta.wma(src, len)
        "HMA"  => ta.hma(src, len)
        "VWMA" => ta.vwma(src, len)
        "RMA"  => ta.rma(src, len)
        => ta.sma(src, len)

f_mtf(float src, simple int len, string kind, simple string tf) =>
    tf == "" or tf == timeframe.period ? f_ma(src, len, kind) : request.security(syminfo.tickerid, tf, f_ma(src, len, kind), barmerge.gaps_off, barmerge.lookahead_off)

f_mtfRsi(simple int len, simple string tf) =>
    tf == "" or tf == timeframe.period ? ta.rsi(close, len) : request.security(syminfo.tickerid, tf, ta.rsi(close, len), barmerge.gaps_off, barmerge.lookahead_off)

// Previous completed HTF bar (fixed for the current period).
f_prevBar(simple string tf) =>
    request.security(syminfo.tickerid, tf, [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_on)

// CPR: TC / Pivot / BC (TC is always the higher of the two wings).
f_cpr(float h, float l, float c) =>
    float piv = (h + l + c) / 3.0
    float bc  = (h + l) / 2.0
    float tc  = piv - bc + piv
    [math.max(tc, bc), piv, math.min(tc, bc)]

f_cam(float h, float l, float c) =>
    float rng = h - l
    float h4 = c + rng * 1.1 / 2.0
    float h3 = c + rng * 1.1 / 4.0
    float l3 = c - rng * 1.1 / 4.0
    float l4 = c - rng * 1.1 / 2.0
    [h4, h3, l3, l4]

// =============================================================================
// ------- CPR LEVELS -------
// =============================================================================
gCpr = "------- CPR LEVELS -------"
autoCpr = input.bool(true, "Auto Select CPR", group = gCpr, tooltip = "Intraday chart → Daily CPR, Daily → Weekly, Weekly → Monthly, Monthly → Yearly. Extra boxes below still add more timeframes.")

showDCpr = input.bool(true,  "Show Daily CPR",   inline = "cprD", group = gCpr)
showPDHL = input.bool(true,  "Show PDH / PDL",   inline = "cprD", group = gCpr)

showWCpr = input.bool(false, "Show Weekly CPR",  inline = "cprW", group = gCpr)
showPWHL = input.bool(false, "Show PWH / PWL",   inline = "cprW", group = gCpr)

showMCpr = input.bool(false, "Show Monthly CPR", inline = "cprM", group = gCpr)
showPMHL = input.bool(false, "Show PMH / PML",   inline = "cprM", group = gCpr)

showYCpr = input.bool(false, "Show Yearly CPR",  inline = "cprY", group = gCpr)
showPYHL = input.bool(false, "Show PYH / PYL",   inline = "cprY", group = gCpr)

// =============================================================================
// ------- CAMARILLA -------
// =============================================================================
gCam = "------- CAMARILLA -------"
showDCam = input.bool(true,  "Show Daily Camarilla",   inline = "camTF", group = gCam)
showWCam = input.bool(false, "Show Weekly Camarilla",  inline = "camTF", group = gCam)
showMCam = input.bool(false, "Show Monthly Camarilla", inline = "camTF", group = gCam)

showCamH4 = input.bool(true,  "Show H4 / L4", inline = "camLv", group = gCam)
showCamH3 = input.bool(true,  "Show H3 / L3", inline = "camLv", group = gCam)

// =============================================================================
// ------- VWAP -------
// =============================================================================
gVwap = "------- VWAP -------"
showVWAP     = input.bool(true,  "Show VWAP", inline = "vwap", group = gVwap)
showVwapBand = input.bool(false, "Show Bands", inline = "vwap", group = gVwap)
vwapSrc      = input.source(hlc3, "VWAP src", inline = "vwap", group = gVwap)
vwapSd1      = input.float(1.0, "SD1", minval = 0.1, step = 0.1, inline = "vwapB", group = gVwap)
vwapSd2      = input.float(2.0, "SD2", minval = 0.1, step = 0.1, inline = "vwapB", group = gVwap)
vwapCol      = input.color(#2196f3, "VWAP color", inline = "vwapB", group = gVwap)

// =============================================================================
// ------- MOVING AVERAGES -------
// =============================================================================
gMa = "------- MOVING AVERAGES -------"
// Each row: tick, type, source, length, timeframe (blank = chart), color

ma1On  = input.bool(true,  "MA #1", inline = "ma1", group = gMa)
ma1Typ = input.string("SMA", "MA1 type", options = ["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], inline = "ma1", group = gMa)
ma1Src = input.source(close, "MA1 src", inline = "ma1", group = gMa)
ma1Len = input.int(10, "MA1 len", minval = 1, inline = "ma1", group = gMa)
ma1Tf  = input.timeframe("", "MA1 TF", inline = "ma1", group = gMa)
ma1Col = input.color(#4caf50, "MA1 color", inline = "ma1", group = gMa)

ma2On  = input.bool(true,  "MA #2", inline = "ma2", group = gMa)
ma2Typ = input.string("SMA", "MA2 type", options = ["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], inline = "ma2", group = gMa)
ma2Src = input.source(close, "MA2 src", inline = "ma2", group = gMa)
ma2Len = input.int(20, "MA2 len", minval = 1, inline = "ma2", group = gMa)
ma2Tf  = input.timeframe("", "MA2 TF", inline = "ma2", group = gMa)
ma2Col = input.color(#ffeb3b, "MA2 color", inline = "ma2", group = gMa)

ma3On  = input.bool(true,  "MA #3", inline = "ma3", group = gMa)
ma3Typ = input.string("SMA", "MA3 type", options = ["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], inline = "ma3", group = gMa)
ma3Src = input.source(close, "MA3 src", inline = "ma3", group = gMa)
ma3Len = input.int(50, "MA3 len", minval = 1, inline = "ma3", group = gMa)
ma3Tf  = input.timeframe("", "MA3 TF", inline = "ma3", group = gMa)
ma3Col = input.color(#00bcd4, "MA3 color", inline = "ma3", group = gMa)

ma4On  = input.bool(false, "MA #4", inline = "ma4", group = gMa)
ma4Typ = input.string("SMA", "MA4 type", options = ["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], inline = "ma4", group = gMa)
ma4Src = input.source(close, "MA4 src", inline = "ma4", group = gMa)
ma4Len = input.int(100, "MA4 len", minval = 1, inline = "ma4", group = gMa)
ma4Tf  = input.timeframe("D", "MA4 TF", inline = "ma4", group = gMa)
ma4Col = input.color(#9c27b0, "MA4 color", inline = "ma4", group = gMa)

ma5On  = input.bool(false, "MA #5", inline = "ma5", group = gMa)
ma5Typ = input.string("SMA", "MA5 type", options = ["SMA", "EMA", "WMA", "HMA", "VWMA", "RMA"], inline = "ma5", group = gMa)
ma5Src = input.source(close, "MA5 src", inline = "ma5", group = gMa)
ma5Len = input.int(200, "MA5 len", minval = 1, inline = "ma5", group = gMa)
ma5Tf  = input.timeframe("D", "MA5 TF", inline = "ma5", group = gMa)
ma5Col = input.color(#ffffff, "MA5 color", inline = "ma5", group = gMa)

// =============================================================================
// ------- RSI -------
// =============================================================================
gRsi = "------- RSI -------"
showRSI   = input.bool(true, "Show RSI", inline = "rsi", group = gRsi)
rsiLen    = input.int(14, "Length", minval = 2, inline = "rsi", group = gRsi)
rsiTf     = input.timeframe("", "TF", inline = "rsi", group = gRsi)
rsiOB     = input.int(70, "OB", minval = 50, maxval = 99, inline = "rsi2", group = gRsi)
rsiOS     = input.int(30, "OS", minval = 1, maxval = 50, inline = "rsi2", group = gRsi)
rsiMarks  = input.bool(true, "Markers", inline = "rsi2", group = gRsi)
rsiPaint  = input.bool(false, "Color bars", inline = "rsi2", group = gRsi)

// =============================================================================
// ------- SUPERTREND -------
// =============================================================================
gSt = "------- SUPERTREND -------"
showST   = input.bool(true, "Show Supertrend", inline = "st", group = gSt)
stAtr    = input.int(10, "ATR", minval = 1, inline = "st", group = gSt)
stFactor = input.float(3.0, "Factor", minval = 0.5, step = 0.1, inline = "st", group = gSt)
stTf     = input.timeframe("", "TF", inline = "st", group = gSt)
stFill   = input.bool(false, "Fill", inline = "st2", group = gSt)
stUpCol  = input.color(#26a69a, "Up", inline = "st2", group = gSt)
stDnCol  = input.color(#ef5350, "Dn", inline = "st2", group = gSt)

// =============================================================================
// Previous D / W / M / Y OHLC
// =============================================================================
[dH, dL, dC] = f_prevBar("D")
[wH, wL, wC] = f_prevBar("W")
[mH, mL, mC] = f_prevBar("M")
[yH, yL, yC] = f_prevBar("12M")

[dTC, dPiv, dBC] = f_cpr(dH, dL, dC)
[wTC, wPiv, wBC] = f_cpr(wH, wL, wC)
[mTC, mPiv, mBC] = f_cpr(mH, mL, mC)
[yTC, yPiv, yBC] = f_cpr(yH, yL, yC)

[dH4, dH3, dL3, dL4] = f_cam(dH, dL, dC)
[wH4, wH3, wL3, wL4] = f_cam(wH, wL, wC)
[mH4, mH3, mL3, mL4] = f_cam(mH, mL, mC)

plotDailyCpr   = showDCpr or (autoCpr and timeframe.isintraday)
plotWeeklyCpr  = showWCpr or (autoCpr and timeframe.isdaily)
plotMonthlyCpr = showMCpr or (autoCpr and timeframe.isweekly)
plotYearlyCpr  = showYCpr or (autoCpr and timeframe.ismonthly)

// =============================================================================
// CPR plots — Style tab lists each level (dots, like the reference chart)
// =============================================================================
dot = plot.style_circles
plot(plotDailyCpr ? dTC  : na, "Daily TC",  color = #2196f3, style = dot, linewidth = 2)
plot(plotDailyCpr ? dPiv : na, "Daily CPR", color = #000000, style = dot, linewidth = 2)
plot(plotDailyCpr ? dBC  : na, "Daily BC",  color = #2196f3, style = dot, linewidth = 2)

plot(plotWeeklyCpr ? wTC  : na, "Weekly TC",  color = #9c27b0, style = dot, linewidth = 2)
plot(plotWeeklyCpr ? wPiv : na, "Weekly CPR", color = #000000, style = dot, linewidth = 2)
plot(plotWeeklyCpr ? wBC  : na, "Weekly BC",  color = #9c27b0, style = dot, linewidth = 2)

plot(plotMonthlyCpr ? mTC  : na, "Monthly TC",  color = #ff9800, style = dot, linewidth = 2)
plot(plotMonthlyCpr ? mPiv : na, "Monthly CPR", color = #000000, style = dot, linewidth = 2)
plot(plotMonthlyCpr ? mBC  : na, "Monthly BC",  color = #ff9800, style = dot, linewidth = 2)

plot(plotYearlyCpr ? yTC  : na, "Yearly TC",  color = #607d8b, style = dot, linewidth = 2)
plot(plotYearlyCpr ? yPiv : na, "Yearly CPR", color = #000000, style = dot, linewidth = 2)
plot(plotYearlyCpr ? yBC  : na, "Yearly BC",  color = #607d8b, style = dot, linewidth = 2)

plot(showPDHL ? dH : na, "Previous Day High",   color = #000000, style = dot, linewidth = 2)
plot(showPDHL ? dL : na, "Previous Day Low",    color = #000000, style = dot, linewidth = 2)
plot(showPWHL ? wH : na, "Previous Week High",  color = #000000, style = dot, linewidth = 2)
plot(showPWHL ? wL : na, "Previous Week Low",   color = #000000, style = dot, linewidth = 2)
plot(showPMHL ? mH : na, "Previous Month High", color = #000000, style = dot, linewidth = 2)
plot(showPMHL ? mL : na, "Previous Month Low",  color = #000000, style = dot, linewidth = 2)
plot(showPYHL ? yH : na, "Previous Year High",  color = #000000, style = dot, linewidth = 2)
plot(showPYHL ? yL : na, "Previous Year Low",   color = #000000, style = dot, linewidth = 2)

// =============================================================================
// Camarilla plots
// =============================================================================
plot(showDCam and showCamH4 ? dH4 : na, "Daily H4", color = #4caf50, style = dot, linewidth = 2)
plot(showDCam and showCamH3 ? dH3 : na, "Daily H3", color = #4caf50, style = dot, linewidth = 2)
plot(showDCam and showCamH3 ? dL3 : na, "Daily L3", color = #f44336, style = dot, linewidth = 2)
plot(showDCam and showCamH4 ? dL4 : na, "Daily L4", color = #f44336, style = dot, linewidth = 2)

plot(showWCam and showCamH4 ? wH4 : na, "Weekly H4", color = #81c784, style = dot, linewidth = 2)
plot(showWCam and showCamH3 ? wH3 : na, "Weekly H3", color = #81c784, style = dot, linewidth = 2)
plot(showWCam and showCamH3 ? wL3 : na, "Weekly L3", color = #e57373, style = dot, linewidth = 2)
plot(showWCam and showCamH4 ? wL4 : na, "Weekly L4", color = #e57373, style = dot, linewidth = 2)

plot(showMCam and showCamH4 ? mH4 : na, "Monthly H4", color = #2e7d32, style = dot, linewidth = 2)
plot(showMCam and showCamH3 ? mH3 : na, "Monthly H3", color = #2e7d32, style = dot, linewidth = 2)
plot(showMCam and showCamH3 ? mL3 : na, "Monthly L3", color = #c62828, style = dot, linewidth = 2)
plot(showMCam and showCamH4 ? mL4 : na, "Monthly L4", color = #c62828, style = dot, linewidth = 2)

// =============================================================================
// VWAP (session)
// =============================================================================
var float sumPV  = 0.0
var float sumV   = 0.0
var float sumP2V = 0.0
float vol = nz(volume)
if ta.change(time("D")) != 0
    sumPV  := vwapSrc * vol
    sumV   := vol
    sumP2V := vwapSrc * vwapSrc * vol
else
    sumPV  += vwapSrc * vol
    sumV   += vol
    sumP2V += vwapSrc * vwapSrc * vol

float vwapVal = sumV == 0 ? vwapSrc : sumPV / sumV
float vwapSd  = sumV == 0 ? 0.0 : math.sqrt(math.max(sumP2V / sumV - vwapVal * vwapVal, 0.0))

pVwap = plot(showVWAP ? vwapVal : na, "VWAP", color = vwapCol, linewidth = 2)
pVu1  = plot(showVWAP and showVwapBand ? vwapVal + vwapSd * vwapSd1 : na, "VWAP +1 SD", color = color.new(vwapCol, 40))
pVl1  = plot(showVWAP and showVwapBand ? vwapVal - vwapSd * vwapSd1 : na, "VWAP -1 SD", color = color.new(vwapCol, 40))
plot(showVWAP and showVwapBand ? vwapVal + vwapSd * vwapSd2 : na, "VWAP +2 SD", color = color.new(vwapCol, 65), style = plot.style_circles)
plot(showVWAP and showVwapBand ? vwapVal - vwapSd * vwapSd2 : na, "VWAP -2 SD", color = color.new(vwapCol, 65), style = plot.style_circles)
fill(pVu1, pVl1, color = showVWAP and showVwapBand ? color.new(vwapCol, 88) : na, title = "VWAP band fill")

// =============================================================================
// Moving averages
// =============================================================================
plot(ma1On ? f_mtf(ma1Src, ma1Len, ma1Typ, ma1Tf) : na, "MA #1", color = ma1Col, linewidth = 2)
plot(ma2On ? f_mtf(ma2Src, ma2Len, ma2Typ, ma2Tf) : na, "MA #2", color = ma2Col, linewidth = 2)
plot(ma3On ? f_mtf(ma3Src, ma3Len, ma3Typ, ma3Tf) : na, "MA #3", color = ma3Col, linewidth = 2)
plot(ma4On ? f_mtf(ma4Src, ma4Len, ma4Typ, ma4Tf) : na, "MA #4", color = ma4Col, linewidth = 2)
plot(ma5On ? f_mtf(ma5Src, ma5Len, ma5Typ, ma5Tf) : na, "MA #5", color = ma5Col, linewidth = 2)

// =============================================================================
// RSI (overlay markers; value is in the data window / alerts)
// =============================================================================
float rsiVal = f_mtfRsi(rsiLen, rsiTf)
bool rsiOBNow = showRSI and rsiVal >= rsiOB
bool rsiOSNow = showRSI and rsiVal <= rsiOS
plotshape(showRSI and rsiMarks and rsiOBNow and not rsiOBNow[1], title = "RSI overbought", style = shape.triangledown, location = location.abovebar, color = #f44336, size = size.tiny)
plotshape(showRSI and rsiMarks and rsiOSNow and not rsiOSNow[1], title = "RSI oversold", style = shape.triangleup, location = location.belowbar, color = #4caf50, size = size.tiny)
barcolor(showRSI and rsiPaint ? (rsiOBNow ? color.new(#f44336, 70) : rsiOSNow ? color.new(#4caf50, 70) : na) : na)
plot(showRSI ? rsiVal : na, "RSI", display = display.data_window)

// =============================================================================
// Supertrend
// =============================================================================
simple string stTfUsed = stTf == "" ? timeframe.period : stTf
[stLine, stDir] = request.security(syminfo.tickerid, stTfUsed, ta.supertrend(stFactor, stAtr), barmerge.gaps_off, barmerge.lookahead_off)
bool stBull = showST and stDir < 0
bool stBear = showST and stDir > 0
pST = plot(showST ? stLine : na, "Supertrend", color = stBull ? stUpCol : stDnCol, linewidth = 2, style = plot.style_linebr)
pPx = plot(showST and stFill ? close : na, "ST fill anchor", display = display.none)
fill(pST, pPx, color = showST and stFill ? (stBull ? color.new(stUpCol, 88) : color.new(stDnCol, 88)) : na, title = "Supertrend fill")
plotshape(showST and stBull and stBear[1], title = "ST bull flip", style = shape.labelup, location = location.belowbar, color = stUpCol, text = "ST", textcolor = color.white, size = size.tiny)
plotshape(showST and stBear and stBull[1], title = "ST bear flip", style = shape.labeldown, location = location.abovebar, color = stDnCol, text = "ST", textcolor = color.white, size = size.tiny)

// =============================================================================
// Alerts
// =============================================================================
alertcondition(showST and stBull and stBear[1], "Supertrend bullish", "Supertrend flipped bullish")
alertcondition(showST and stBear and stBull[1], "Supertrend bearish", "Supertrend flipped bearish")
alertcondition(showRSI and rsiOBNow and not rsiOBNow[1], "RSI overbought", "RSI entered overbought")
alertcondition(showRSI and rsiOSNow and not rsiOSNow[1], "RSI oversold", "RSI entered oversold")
alertcondition(showVWAP and ta.crossover(close, vwapVal), "Cross above VWAP", "Price crossed above VWAP")
alertcondition(showVWAP and ta.crossunder(close, vwapVal), "Cross below VWAP", "Price crossed below VWAP")
alertcondition(plotDailyCpr and ta.crossover(close, dTC), "Break above Daily CPR", "Price broke above Daily TC")
alertcondition(plotDailyCpr and ta.crossunder(close, dBC), "Break below Daily CPR", "Price broke below Daily BC")
alertcondition(showDCam and showCamH4 and ta.crossover(close, dH4), "Camarilla H4 break", "Price broke Daily H4")
alertcondition(showDCam and showCamH4 and ta.crossunder(close, dL4), "Camarilla L4 break", "Price broke Daily L4")
