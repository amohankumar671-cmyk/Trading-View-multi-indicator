//@version=6
indicator("Volume Profile", shorttitle = "VP", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// Daily-session volume profile only. Keep CPR / Camarilla / VWAP in
// cpr_vwap_camarilla_suite.pine and add this script as a second overlay.

type VpResult
    float poc
    float vah
    float val
    int pocI
    int loI
    int hiI
    float tot
    float maxV

f_fillProfile(array<float> highs, array<float> lows, array<float> vols, array<float> prof, int nBins, float sL, float sH) =>
    array.fill(prof, 0.0)
    float rng = sH - sL
    int n = array.size(highs)
    if rng > 0 and n > 0
        float binSz = rng / nBins
        for i = 0 to n - 1
            float bh = array.get(highs, i)
            float bl = array.get(lows, i)
            float bv = array.get(vols, i)
            int i0 = int((bl - sL) / binSz)
            int i1 = int((bh - sL) / binSz)
            i0 := math.max(0, math.min(nBins - 1, i0))
            i1 := math.max(0, math.min(nBins - 1, i1))
            if bh >= sH
                i1 := nBins - 1
            int span = math.max(1, i1 - i0 + 1)
            float share = bv / span
            for b = i0 to i1
                array.set(prof, b, array.get(prof, b) + share)
    rng > 0 ? rng / nBins : 0.0

f_pocVa(array<float> prof, int nBins, float sL, float binSz, float vaPct) =>
    int pocI = 0
    float maxV = array.get(prof, 0)
    float tot = 0.0
    for b = 0 to nBins - 1
        float v = array.get(prof, b)
        tot += v
        if v > maxV
            maxV := v
            pocI := b
    float target = tot * vaPct / 100.0
    float acc = array.get(prof, pocI)
    int loI = pocI
    int hiI = pocI
    int guard = 0
    while acc < target and guard < nBins
        guard += 1
        float below = loI > 0 ? array.get(prof, loI - 1) : -1.0
        float above = hiI < nBins - 1 ? array.get(prof, hiI + 1) : -1.0
        if above >= below and hiI < nBins - 1
            hiI += 1
            acc += array.get(prof, hiI)
        else if loI > 0
            loI -= 1
            acc += array.get(prof, loI)
        else if hiI < nBins - 1
            hiI += 1
            acc += array.get(prof, hiI)
        else
            break
    float pocPx = sL + (pocI + 0.5) * binSz
    float valPx = sL + loI * binSz
    float vahPx = sL + (hiI + 1) * binSz
    VpResult.new(pocPx, vahPx, valPx, pocI, loI, hiI, tot, maxV)

f_dashCell(table t, int r, string k, string v, color vc) =>
    table.cell(t, 0, r, k, text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(t, 1, r, v, text_color = vc, text_halign = text.align_right, text_size = size.small)

// One horizontal segment per session. On a new day the old line is frozen;
// the live line is moved, not redrawn as a circle on every bar.
f_vpLevel(bool on, float px, color col, int w, string sty, string name, bool newDay, int t0, int lookback, bool showLab) =>
    var line ln = na
    var label curLab = na
    var line[] hist = array.new<line>()
    var label[] labs = array.new<label>()
    int tNow = time
    if not on or na(px)
        if not na(ln)
            line.delete(ln)
            ln := na
        if not na(curLab)
            label.delete(curLab)
            curLab := na
        while array.size(hist) > 0
            line.delete(array.pop(hist))
        while array.size(labs) > 0
            label.delete(array.pop(labs))
    else
        if newDay and not na(ln)
            line.set_xy1(ln, line.get_x1(ln), px[1])
            line.set_xy2(ln, time[1], px[1])
            line.set_extend(ln, extend.none)
            array.push(hist, ln)
            if showLab
                array.push(labs, label.new(line.get_x1(ln), px[1], name, xloc = xloc.bar_time, style = label.style_label_right, color = color.new(color.white, 100), textcolor = col, size = size.tiny))
            while array.size(hist) > lookback
                line.delete(array.shift(hist))
            while array.size(labs) > lookback
                label.delete(array.shift(labs))
            ln := line.new(t0, px, tNow, px, xloc = xloc.bar_time, extend = extend.none, color = col, style = sty, width = w)
        else if na(ln)
            ln := line.new(t0, px, tNow, px, xloc = xloc.bar_time, extend = extend.none, color = col, style = sty, width = w)
        else
            line.set_xy1(ln, t0, px)
            line.set_xy2(ln, tNow, px)
            line.set_extend(ln, extend.none)
            line.set_color(ln, col)
            line.set_style(ln, sty)
            line.set_width(ln, w)
        if showLab
            if na(curLab)
                curLab := label.new(t0, px, name, xloc = xloc.bar_time, style = label.style_label_right, color = color.new(color.white, 100), textcolor = col, size = size.tiny)
            else
                label.set_xy(curLab, t0, px)
                label.set_text(curLab, name)
                label.set_textcolor(curLab, col)
        else if not na(curLab)
            label.delete(curLab)
            curLab := na
    ln

colGrn = #089981
colRed = #F23645
colOrg = #ff9800
colPoc = #e91e63
colVah = #26a69a
colVal = #ab47bc

gVp = "------- VOLUME PROFILE -------"
vpBins     = input.int(24, "Rows", minval = 8, maxval = 48, group = gVp)
vpVaPct    = input.float(70.0, "Value area %", minval = 50.0, maxval = 95.0, step = 1.0, group = gVp)
vpWidth    = input.int(18, "Histogram width (bars)", minval = 4, maxval = 80, group = gVp)
showHist   = input.bool(true, "Show histogram", group = gVp)
showPoc    = input.bool(true, "Show POC", inline = "poc", group = gVp)
showVahVal = input.bool(true, "Show VAH / VAL", inline = "poc", group = gVp)
showPrevVp = input.bool(true, "Show previous session POC / VAH / VAL", group = gVp)
showVaFill = input.bool(true, "Shade value area", group = gVp)
histVaCol  = input.color(color.new(#26a69a, 55), "VA bin", inline = "hist", group = gVp)
histOutCol = input.color(color.new(#787b86, 70), "Outside bin", inline = "hist", group = gVp)
histPocCol = input.color(color.new(#e91e63, 35), "POC bin", inline = "hist", group = gVp)

gChk = "------- VOLUME CHECKS -------"
nearPct    = input.float(0.12, "Near POC %", minval = 0.01, maxval = 1.0, step = 0.01, tooltip = "Price is near POC when the distance is within this percent of price.", group = gChk)
bgVpStatus = input.bool(true, "Background: inside / outside value area", group = gChk)
showTable  = input.bool(true, "Show status table", group = gChk)
showMarks  = input.bool(true, "Mark POC tests and VA breaks", group = gChk)

gSig = "------- BUY / SELL -------"
showSignals = input.bool(true, "Show BUY / SELL on strong breaks", group = gSig)
sigPrev     = input.bool(true, "Break previous session VAH / VAL", tooltip = "More stable. Buy = close breaks above yesterday's VAH. Sell = close breaks below yesterday's VAL.", group = gSig)
sigCurr     = input.bool(false, "Break current session VAH / VAL", tooltip = "Noisier because today's VAH/VAL still move. Off by default.", group = gSig)
atrLen      = input.int(14, "ATR length", minval = 1, group = gSig)
atrMult     = input.float(0.5, "Min bar change vs ATR", minval = 0.1, step = 0.1, tooltip = "High-change filter: |close - close[1]| must be at least this times ATR so tiny pokes do not fire.", group = gSig)
volLen      = input.int(20, "Volume average length", minval = 1, group = gSig)
volMult     = input.float(1.2, "Min volume vs average", minval = 0.0, step = 0.1, tooltip = "Break bar volume must be at least this times SMA(volume). Set 0 to ignore volume.", group = gSig)
needBody    = input.bool(true, "Require bullish / bearish close vs open", group = gSig)
fromInside  = input.bool(true, "Current-session break must leave value", tooltip = "For current VAH/VAL signals, the previous close must be inside the value area.", group = gSig)

float vol = nz(volume)
bool newDay = ta.change(time("D")) != 0

var array<float> sessH = array.new_float()
var array<float> sessL = array.new_float()
var array<float> sessV = array.new_float()
var array<float> prof  = array.new_float()
var float prevPoc = na
var float prevVah = na
var float prevVal = na
var int sessT0 = time
int vpLookback = 15

if barstate.isfirst
    array.clear(prof)
    for i = 0 to vpBins - 1
        array.push(prof, 0.0)

if newDay
    sessT0 := time

if newDay and array.size(sessH) > 0
    float pH = array.max(sessH)
    float pL = array.min(sessL)
    float pBin = f_fillProfile(sessH, sessL, sessV, prof, vpBins, pL, pH)
    if pBin > 0
        VpResult prevR = f_pocVa(prof, vpBins, pL, pBin, vpVaPct)
        prevPoc := prevR.poc
        prevVah := prevR.vah
        prevVal := prevR.val
    array.clear(sessH)
    array.clear(sessL)
    array.clear(sessV)

array.push(sessH, high)
array.push(sessL, low)
array.push(sessV, vol)

float sH = array.max(sessH)
float sL = array.min(sessL)
float binSz = f_fillProfile(sessH, sessL, sessV, prof, vpBins, sL, sH)
float poc = na
float vah = na
float val = na
int pocI = 0
int loI = 0
int hiI = 0
float totV = 0.0
float maxV = 0.0
if binSz > 0
    VpResult r = f_pocVa(prof, vpBins, sL, binSz, vpVaPct)
    poc := r.poc
    vah := r.vah
    val := r.val
    pocI := r.pocI
    loI := r.loI
    hiI := r.hiI
    totV := r.tot
    maxV := r.maxV

plot(poc, "POC", color = colPoc, display = display.data_window + display.status_line)
plot(vah, "VAH", color = colVah, display = display.data_window + display.status_line)
plot(val, "VAL", color = colVal, display = display.data_window + display.status_line)
plot(prevPoc, "Prev POC", color = colPoc, display = display.data_window + display.status_line)
plot(prevVah, "Prev VAH", color = colVah, display = display.data_window + display.status_line)
plot(prevVal, "Prev VAL", color = colVal, display = display.data_window + display.status_line)

f_vpLevel(showPoc, poc, colPoc, 2, line.style_solid, "POC", newDay, sessT0, vpLookback, true)
f_vpLevel(showVahVal, vah, colVah, 2, line.style_solid, "VAH", newDay, sessT0, vpLookback, true)
f_vpLevel(showVahVal, val, colVal, 2, line.style_solid, "VAL", newDay, sessT0, vpLookback, true)
f_vpLevel(showPrevVp, prevPoc, colPoc, 1, line.style_dotted, "Prev POC", newDay, sessT0, vpLookback, true)
f_vpLevel(showPrevVp, prevVah, colVah, 1, line.style_dotted, "Prev VAH", newDay, sessT0, vpLookback, true)
f_vpLevel(showPrevVp, prevVal, colVal, 1, line.style_dotted, "Prev VAL", newDay, sessT0, vpLookback, true)

var box vaBox = na
if newDay and not na(vaBox)
    box.delete(vaBox)
    vaBox := na
bool canFillVa = showVaFill and not na(vah) and not na(val)
if canFillVa
    if na(vaBox)
        vaBox := box.new(sessT0, vah, time, val, xloc = xloc.bar_time, border_color = color.new(color.white, 100), bgcolor = color.new(#26a69a, 90))
    else
        box.set_left(vaBox, sessT0)
        box.set_right(vaBox, time)
        box.set_top(vaBox, vah)
        box.set_bottom(vaBox, val)
else if not na(vaBox)
    box.delete(vaBox)
    vaBox := na

var array<box> vpBoxes = array.new<box>()
if barstate.islast
    while array.size(vpBoxes) > 0
        box.delete(array.pop(vpBoxes))
    if showHist and binSz > 0 and maxV > 0
        for b = 0 to vpBins - 1
            float v = array.get(prof, b)
            int w = math.max(1, int(math.round(v / maxV * vpWidth)))
            float y1 = sL + b * binSz
            float y2 = y1 + binSz
            color bc = b == pocI ? histPocCol : (b >= loI and b <= hiI ? histVaCol : histOutCol)
            box bx = box.new(bar_index - w, y2, bar_index + 1, y1, xloc = xloc.bar_index, border_color = color.new(bc, 20), bgcolor = bc, text = b == pocI ? "POC" : "")
            array.push(vpBoxes, bx)

float nearAbs = nz(close) * nearPct / 100.0
bool haveVp   = not na(poc) and not na(vah) and not na(val)
bool inVA     = haveVp and close <= vah and close >= val
bool aboveVAH = haveVp and close > vah
bool nearPoc  = haveVp and math.abs(close - poc) <= nearAbs
bool testPoc  = nearPoc and (low <= poc and high >= poc)
bool breakVAH = haveVp and ta.crossover(close, vah)
bool breakVAL = haveVp and ta.crossunder(close, val)
bool rejectVAH = haveVp and high >= vah and close < vah and close[1] <= vah
bool rejectVAL = haveVp and low <= val and close > val and close[1] >= val

float atrNow = ta.atr(atrLen)
float barChg = math.abs(close - close[1])
bool highChg = not na(atrNow) and atrNow > 0 and barChg >= atrNow * atrMult
float volAvg = ta.sma(volume, volLen)
bool highVol = volMult <= 0 or (volAvg > 0 and volume >= volAvg * volMult)
bool bullBar = not needBody or close > open
bool bearBar = not needBody or close < open
bool leftValueUp   = not fromInside or inVA[1]
bool leftValueDown = not fromInside or inVA[1]
bool havePrevVa = not na(prevVah) and not na(prevVal)

bool buyPrev  = sigPrev and havePrevVa and ta.crossover(close, prevVah) and highChg and highVol and bullBar
bool sellPrev = sigPrev and havePrevVa and ta.crossunder(close, prevVal) and highChg and highVol and bearBar
bool buyCurr  = sigCurr and breakVAH and highChg and highVol and bullBar and leftValueUp
bool sellCurr = sigCurr and breakVAL and highChg and highVol and bearBar and leftValueDown
bool buySig   = showSignals and (buyPrev or buyCurr) and not (sellPrev or sellCurr)
bool sellSig  = showSignals and (sellPrev or sellCurr) and not (buyPrev or buyCurr)

string locTxt = not haveVp ? "n/a" : inVA ? "Inside value" : aboveVAH ? "Above VAH" : "Below VAL"
color locCol  = not haveVp ? color.gray : inVA ? colGrn : aboveVAH ? colOrg : colRed

bgcolor(bgVpStatus and haveVp ? (inVA ? color.new(colGrn, 94) : color.new(colRed, 94)) : na, title = "VA status")

bool testPocOnce = testPoc and not testPoc[1]
plotshape(showMarks and testPocOnce ? poc : na, title = "POC test", style = shape.diamond, location = location.absolute, size = size.tiny, color = colPoc, text = "POC")
plotshape(showMarks and breakVAH, title = "VAH break", style = shape.triangleup, location = location.belowbar, size = size.tiny, color = colGrn, text = "VAH")
plotshape(showMarks and breakVAL, title = "VAL break", style = shape.triangledown, location = location.abovebar, size = size.tiny, color = colRed, text = "VAL")
plotshape(buySig, title = "BUY", text = "BUY", style = shape.labelup, location = location.belowbar, size = size.small, color = color.new(#0022FC, 0), textcolor = color.white)
plotshape(sellSig, title = "SELL", text = "SELL", style = shape.labeldown, location = location.abovebar, size = size.small, color = color.new(color.maroon, 0), textcolor = color.white)

var table dash = table.new(position.top_right, 2, 13, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.new(color.gray, 40))

if barstate.islast and showTable
    table.cell(dash, 0, 0, "Volume Profile", text_color = color.black, text_halign = text.align_left, text_size = size.normal)
    table.cell(dash, 1, 0, totV == 0 ? "no volume" : str.tostring(vpVaPct, "#") + "% VA", text_color = color.black, text_halign = text.align_right, text_size = size.small)
    f_dashCell(dash, 1, "Location", locTxt, locCol)
    f_dashCell(dash, 2, "POC", haveVp ? str.tostring(poc, format.mintick) : "n/a", colPoc)
    f_dashCell(dash, 3, "VAH", haveVp ? str.tostring(vah, format.mintick) : "n/a", colVah)
    f_dashCell(dash, 4, "VAL", haveVp ? str.tostring(val, format.mintick) : "n/a", colVal)
    f_dashCell(dash, 5, "Prev POC", na(prevPoc) ? "n/a" : str.tostring(prevPoc, format.mintick), colPoc)
    f_dashCell(dash, 6, "Prev VAH", na(prevVah) ? "n/a" : str.tostring(prevVah, format.mintick), colVah)
    f_dashCell(dash, 7, "Prev VAL", na(prevVal) ? "n/a" : str.tostring(prevVal, format.mintick), colVal)
    f_dashCell(dash, 8, "Near POC", nearPoc ? "YES" : "no", nearPoc ? colPoc : color.gray)
    f_dashCell(dash, 9, "High change", highChg ? "YES" : "no", highChg ? colGrn : color.gray)
    f_dashCell(dash, 10, "High volume", highVol ? "YES" : "no", highVol ? colGrn : color.gray)
    f_dashCell(dash, 11, "BUY", buySig ? "YES" : "no", buySig ? colGrn : color.gray)
    f_dashCell(dash, 12, "SELL", sellSig ? "YES" : "no", sellSig ? colRed : color.gray)
else if barstate.islast and not showTable
    table.clear(dash, 0, 0, 1, 12)

alertcondition(testPoc, "POC test", "Price traded through session POC")
alertcondition(breakVAH, "Break above VAH", "Price closed above Value Area High")
alertcondition(breakVAL, "Break below VAL", "Price closed below Value Area Low")
alertcondition(rejectVAH, "VAH rejection", "Wick above VAH, close back inside value")
alertcondition(rejectVAL, "VAL rejection", "Wick below VAL, close back inside value")
alertcondition(buySig, "BUY strong VAH break", "Strong high-change break above value area high")
alertcondition(sellSig, "SELL strong VAL break", "Strong high-change break below value area low")
